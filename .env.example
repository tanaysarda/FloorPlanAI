# Copy to .env (git-ignored) and fill in ONLY if you want the optional LLM mode.
# Without any key the app runs fully on the built-in deterministic engine.
LLM_PROVIDER=anthropic        # anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=                    # optional; defaults: claude-sonnet-4-6 / gpt-4o-mini
